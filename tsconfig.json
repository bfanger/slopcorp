{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "dom-chromium-ai", "vite/client"],
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "src/**/*.svelte",
    "*.config.js",
    "**/*.ts",
    ".*/**/*.ts",
    "**/*.cjs",
    ".*/**/*.cjs",
    ".*.cjs",
    "**/*.js",
    ".*.js"
  ]
}
